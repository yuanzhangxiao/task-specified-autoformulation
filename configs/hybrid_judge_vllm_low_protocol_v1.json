    "partial_tiebreak_weight": 0.05,
    "comparative_weight": 0.25
  },
  "logical_call": {
    "max_provider_attempts": 10,
    "timeout_seconds": 900,
    "reasoning_effort": "low",
    "temperature": 0.2
  }
}
