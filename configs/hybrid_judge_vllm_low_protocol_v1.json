{
  "schema_version": "hybrid-judge-protocol-1",
  "status": "frozen_for_vllm_low_full_heldout_evaluation",
  "judge_model": "vllm:openai/gpt-oss-20b",
  "transport": "vllm_openai_chat_json_schema",
  "tool_fallback": false,
  "candidate_order_policy": "both_orientations",
