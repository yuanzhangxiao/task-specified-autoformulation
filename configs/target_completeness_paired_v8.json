{
  "schema_version": "paired-target-completeness-validation-1",
  "status": "frozen_before_paired_target_only_calls",
  "purpose": "fairly evaluate V6 target-completeness logic without coupling it to atomic or comparative stages",
  "judge_model": "vllm:openai/gpt-oss-120b",
  "source_control": {
    "source_experiment": "judge-hybrid-target-mapping-v6-fail-closed",
    "pair_bytes_must_match_source": true,
    "label_bytes_must_match_source": true,
    "candidate_payloads_unchanged_before_blinding": true,
    "public_prompt_unchanged": true,
    "judge_model_unchanged": true,
    "provider_attempt_limit_unchanged": true,
    "intended_changes": [
      "retain simultaneous visibility of both candidates",
      "ask only absolute target-completeness questions for each candidate",
      "remove signed-occurrence and exact-repeat questions",
      "remove source/sink and other hybrid absolute questions",
      "remove comparative questions, preference, and numeric score",
      "treat both orientations at one seed as an atomic transaction",
      "retry both orientations with a fresh seed after either orientation fails"
    ]
  },
  "public_prompt_contract": {
    "benchmark_id": "phase_b_dalla_man_t2_canonical_named_easy",
    "proposer_prompt_sha256": "f8268dff206d6337dd284f98a48f26d50bb114877336561fff7548c69c94d8cd"
  },
  "pair_construction": {
    "mutation_type": "omitted_target_component",
    "target_channel": "U",
    "valid_total_expression": "Uii + Uid",
    "mutated_total_expression": "Uid",
    "mutation_labels_visible_to_judge": false
  },
  "protocol": {
    "protocol_version": "paired-target-completeness-judge-1",
    "candidate_policy": "two_visible_independently_assessed_candidates",
    "candidate_order_policy": "both_orientations_same_seed",
    "target_policy": "all_public_targets",
    "consensus": {
      "identity_normalization": true,
      "pass_pass": "pass",
      "any_fail": "fail",
      "otherwise": "indeterminate"
    },
    "paired_retry_policy": "discard_both_orientations_and_advance_seed_if_either_fails",
    "atomic_stage_enabled": false,
    "comparative_questions_enabled": false,
    "numeric_score_defined": false,
    "reasoning_effort": "low",
    "temperature": 0.2,
    "seed_base": 10000,
    "repetitions": 5,
    "max_provider_attempts": 10,
    "max_paired_seed_attempts": 2,
    "seed_allocation": "nonoverlapping_provider_attempt_blocks_v1",
    "response_contract": {
      "verdicts": [
        "pass",
        "fail",
        "indeterminate"
      ],
      "exact_runtime_target_ids_required": true,
      "both_candidate_answers_required_per_target": true,
      "not_applicable_forbidden": true,
      "missing_or_extra_target_ids": "retry_whole_pair_then_terminal",
      "scientific_verdict_repair": false
    }
  },
  "planned": {
    "baseline_structures": 2,
    "pairs": 2,
    "paired_trials": 10,
    "orientations_per_seed": 2,
    "initial_logical_llm_calls": 20,
    "maximum_logical_llm_calls": 40,
    "llm_stages_per_orientation": 1,
    "gpus": 4,
    "tensor_parallel_size": 4
  },
  "validation_gate": {
    "minimum_paired_trial_coverage": 0.95,
    "minimum_candidate_verdict_accuracy": 0.90,
    "minimum_complete_trial_accuracy": 0.90,
    "minimum_pair_aggregate_accuracy": 1.00,
    "minimum_all_target_unit_accuracy": 0.90,
    "minimum_evaluated_target_accuracy": 0.90,
    "minimum_valid_target_pass_rate": 0.90,
    "minimum_incomplete_target_fail_rate": 0.90,
    "minimum_orientation_verdict_consistency": 0.80,
    "minimum_repeat_modal_consistency": 0.90
  },
  "decision_rule": "pass only if every predeclared gate passes",
  "next_if_passed": "confirm the unchanged paired target-only protocol on fresh unseen candidate structures before search integration",
  "next_if_failed": "keep semantic target completeness out of production search and report the frozen failure"
}
