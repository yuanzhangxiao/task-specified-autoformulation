          "const": false,
          "default": false,
          "title": "Between Sample Behavior Certified",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "title": "BranchSummary",
      "type": "object"
    },
