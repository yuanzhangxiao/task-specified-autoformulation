          "type": "string"
        },
        "primitive": {
          "enum": [
            "abs",
            "min",
            "max"
          ],
          "title": "Primitive",
          "type": "string"
        },
        "fold": {
          "title": "Fold",
          "type": "integer"
        },
        "samples": {
          "title": "Samples",
          "type": "integer"
        },
        "minimum_absolute_margin": {
          "title": "Minimum Absolute Margin",
          "type": "number"
        },
        "minimum_scaled_margin": {
          "title": "Minimum Scaled Margin",
          "type": "number"
        },
        "near_tie_samples": {
          "title": "Near Tie Samples",
          "type": "integer"
        },
        "left_or_positive_samples": {
          "title": "Left Or Positive Samples",
          "type": "integer"
        },
        "right_or_negative_samples": {
          "title": "Right Or Negative Samples",
          "type": "integer"
        },
        "sampled_activity_changes": {
          "title": "Sampled Activity Changes",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "location",
        "expression",
        "primitive",
        "fold",
        "samples",
        "minimum_absolute_margin",
        "minimum_scaled_margin",
        "near_tie_samples",
        "left_or_positive_samples",
        "right_or_negative_samples",
        "sampled_activity_changes"
      ],
      "title": "BranchActivity",
      "type": "object"
    },
    "BranchSummary": {
      "additionalProperties": false,
      "description": "Margins at observations and causal initial maps, never between them.",
      "properties": {
        "status": {
          "default": "complete",
          "enum": [
            "complete",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "sample_scope": {
          "const": "stored_output_states_and_causal_initial_maps",
          "default": "stored_output_states_and_causal_initial_maps",
          "title": "Sample Scope",
          "type": "string"
        },
        "branches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BranchActivity"
          },
          "title": "Branches",
          "type": "array"
        },
        "trajectory_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
