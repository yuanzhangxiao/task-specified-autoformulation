          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parameters Sha256"
        },
        "fit_sha256": {
          "title": "Fit Sha256",
          "type": "string"
        },
        "backend_sha256": {
          "title": "Backend Sha256",
          "type": "string"
        },
