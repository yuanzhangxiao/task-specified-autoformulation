{
  "$defs": {
    "ConstraintEnforcement": {
      "description": "Whether violation blocks execution or contributes soft evidence.",
      "enum": [
        "hard",
        "soft"
      ],
      "title": "ConstraintEnforcement",
      "type": "string"
    },
    "ConstraintKind": {
      "description": "Machine-readable constraint categories.",
      "enum": [
        "nonnegative",
        "positive",
        "bounded",
        "monotone_increasing",
        "monotone_decreasing",
        "conservation",
        "custom"
      ],
      "title": "ConstraintKind",
      "type": "string"
    },
    "ConstraintSource": {
      "description": "Runtime-owned provenance for a constraint declaration.",
      "enum": [
        "unspecified",
        "proposer",
        "benchmark",
        "runtime",
        "deterministic"
      ],
      "title": "ConstraintSource",
      "type": "string"
    },
    "ConstraintSpec": {
      "additionalProperties": false,
      "description": "Constraint attached to a declared model symbol.",
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "unspecified",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "enforcement": {
          "$ref": "#/$defs/ConstraintEnforcement",
          "default": "hard"
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind"
        },
        "source": {
          "$ref": "#/$defs/ConstraintSource",
          "default": "unspecified"
        },
        "subject": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "kind"
      ],
      "title": "ConstraintSpec",
      "type": "object"
    },
    "InitialConditionSpec": {
      "additionalProperties": false,
      "description": "One explicit initialization rule for a modeled state.",
      "properties": {
        "expression": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "fixed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Value"
        },
        "initialization_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "$ref": "#/$defs/ParameterScope"
        },
        "state": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "scope"
      ],
      "title": "InitialConditionSpec",
      "type": "object"
    },
    "ObservationMapping": {
      "additionalProperties": false,
      "description": "Mapping from model symbols to one measured target channel.",
      "properties": {
        "channel": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Channel",
          "type": "string"
        },
        "expression": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "unit": {
          "default": "unspecified",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "expression"
      ],
      "title": "ObservationMapping",
      "type": "object"
    },
    "ParameterDomain": {
      "description": "Qualitative physical domain without a proposer-owned magnitude range.",
      "enum": [
        "real",
        "nonnegative",
        "positive"
      ],
      "title": "ParameterDomain",
      "type": "string"
    },
    "ParameterRole": {
      "description": "Small operational role vocabulary used to derive parameter domains.",
      "enum": [
        "coefficient",
        "nonnegative_coefficient",
        "rate",
        "time_constant",
        "scale",
        "offset",
        "shape",
        "positive_shape"
      ],
      "title": "ParameterRole",
      "type": "string"
    },
    "ParameterScope": {
      "description": "Sharing scope for a fitted scalar.",
      "enum": [
        "global",
        "trajectory_specific"
      ],
      "title": "ParameterScope",
      "type": "string"
    },
    "ParameterSpec": {
      "additionalProperties": false,
      "description": "Scalar fitted parameter with optional legacy numerical ranges.\n\nNew proposer outputs omit ranges.  The optional fields remain readable so\nhistorical candidates and externally supplied runtime contracts retain\ndeterministic replay compatibility.",
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "unspecified",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/ParameterDomain",
          "default": "real"
        },
        "initialization_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ParameterRole",
          "default": "coefficient"
        },
        "scope": {
          "$ref": "#/$defs/ParameterScope"
        },
        "unit": {
          "default": "unspecified",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "scope"
      ],
      "title": "ParameterSpec",
      "type": "object"
    },
    "ProcessSpec": {
      "additionalProperties": false,
      "description": "Algebraic generated process evaluated from declared symbols.",
      "properties": {
        "description": {
          "default": "unspecified",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "expression": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "mechanisms": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Mechanisms",
          "type": "array"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "default": "unspecified",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "expression"
      ],
      "title": "ProcessSpec",
      "type": "object"
    },
    "ProposedEquation": {
      "additionalProperties": false,
      "description": "Proposer-facing equation whose left-hand side defines its semantics.\n\n``dx/dt`` or ``d(x)/dt`` is a derivative equation. A plain identifier,\nincluding ``x_rate``, is an algebraic process unless ``derivative_of``\nexplicitly links that process to a declared dynamic state.",
      "properties": {
        "derivative_of": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derivative Of"
        },
        "lhs": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Lhs",
          "type": "string"
        },
        "rhs": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Rhs",
          "type": "string"
        }
      },
      "required": [
        "lhs",
        "rhs"
      ],
      "title": "ProposedEquation",
      "type": "object"
    },
    "StateEquation": {
      "additionalProperties": false,
      "description": "Canonical derivative equation for exactly one declared state.",
      "properties": {
        "rhs": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Rhs",
          "type": "string"
        },
        "state": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "rhs"
      ],
      "title": "StateEquation",
      "type": "object"
    },
    "StateKind": {
      "description": "Whether a modeled state is measured or inferred.",
      "enum": [
        "observed",
        "latent"
      ],
      "title": "StateKind",
      "type": "string"
    },
    "StateSpec": {
      "additionalProperties": false,
      "description": "Observed or latent dynamic state declaration.",
      "properties": {
        "description": {
          "default": "unspecified",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/StateKind"
        },
        "mechanisms": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Mechanisms",
          "type": "array"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "default": "unspecified",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "StateSpec",
      "type": "object"
    },
    "ValueRange": {
      "additionalProperties": false,
      "description": "Closed finite numeric interval.",
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ValueRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete machine-readable proposer candidate.",
  "properties": {
    "candidate_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "title": "Candidate Id",
      "type": "string"
    },
    "change_summary": {
      "default": "unspecified",
      "maxLength": 10000,
      "minLength": 1,
      "title": "Change Summary",
      "type": "string"
    },
    "constraints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ConstraintSpec"
      },
      "maxItems": 256,
      "title": "Constraints",
      "type": "array"
    },
    "equations": {
      "default": [],
      "description": "Explicit-LHS proposer equations. Derivatives use dx/dt or d(x)/dt. Plain identifiers, including x_rate, are algebraic unless linked with derivative_of. Normalized on input.",
      "items": {
        "$ref": "#/$defs/ProposedEquation"
      },
      "maxItems": 320,
      "title": "Equations",
      "type": "array"
    },
    "initial_conditions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InitialConditionSpec"
      },
      "maxItems": 64,
      "title": "Initial Conditions",
      "type": "array"
    },
    "observation_mappings": {
      "items": {
        "$ref": "#/$defs/ObservationMapping"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Observation Mappings",
      "type": "array"
    },
    "parameters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ParameterSpec"
      },
      "maxItems": 256,
      "title": "Parameters",
      "type": "array"
    },
    "parent_candidate_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Candidate Id"
    },
    "processes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProcessSpec"
      },
      "maxItems": 256,
      "title": "Processes",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "state_equations": {
      "default": [],
      "description": "Canonical/legacy derivative equations; proposers should use equations.",
      "items": {
        "$ref": "#/$defs/StateEquation"
      },
      "maxItems": 64,
      "title": "State Equations",
      "type": "array"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/StateSpec"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "States",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "parent_candidate_id",
    "states",
    "observation_mappings"
  ],
  "title": "CandidateModel",
  "type": "object"
}
